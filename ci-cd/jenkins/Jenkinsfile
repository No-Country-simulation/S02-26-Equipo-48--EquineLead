// Jenkinsfile Maestro - Ejecuta todos los componentes
// 
// Analogía: Este Jenkinsfile es como el "director de orquesta" que coordina
// a todos los mecánicos (otros Jenkinsfiles) para hacer una inspección completa del vehículo.

pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'EquineLead - Full Stack'
        // IP del App Server activo. Cambiar aquí si se migra de AWS a OCI.
        // En Jenkins: Manage Jenkins > Configure System > Global properties > Environment variables
        APP_SERVER_IP   = credentials('app-server-ip')   // registrar en Jenkins Credentials como 'Secret text'
        APP_SERVER_USER = 'ubuntu'
    }
    
    stages {
        stage('🔍 Checkout') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📥 Descargando código del repositorio...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                checkout scm
            }
        }
        
        stage('🔍 Check Builds') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔍 Verificando que todos los componentes compilen...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/check_builds.sh | tee builds.log'
            }
        }
        
        stage('🧪 Run All Tests') {
            when {
                not { branch 'gh-pages' }
            }
            parallel {
                stage('Backend C#') {
                    steps {
                        echo '🔧 Ejecutando tests de Backend C#...'
                        sh './tests/scripts/run_backend_tests.sh'
                    }
                }
                
                stage('Data Science') {
                    steps {
                        echo '🧠 Ejecutando tests de Data Science...'
                        sh './tests/scripts/run_datascience_tests.sh | tee ds_tests.log'
                    }
                }
                
                stage('Scrapper Rust') {
                    steps {
                        echo '🦀 Ejecutando tests de Scrapper Rust...'
                        sh './tests/scripts/run_scrapper_tests.sh'
                    }
                }
                
                stage('Frontend Web') {
                    steps {
                        echo '🎨 Ejecutando tests de Frontend Web...'
                        sh './tests/scripts/run_frontend_tests.sh'
                    }
                }
            }
        }
        
        stage('🔗 Integration Tests') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔗 Ejecutando tests de integración...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/run_integration_tests.sh || echo "Integration tests no disponibles aún"'
            }
        }
        
        stage('🚀 Deploy Mock to AWS') {
            when {
                branch 'dev'
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🚀 Desplegando Mock (Nginx) en AWS App Server Plan B...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'aws-app-server-key',
                    keyFileVariable: 'SSH_KEY_FILE',
                    usernameVariable: 'SSH_USER'
                )]) {
                    sh '''
                        TARGET="${APP_SERVER_USER}@${APP_SERVER_IP}"
                        COMPOSE_FILE="infrastructure/docker/docker-compose.mock.yml"
                        SSH_OPTS="-i $SSH_KEY_FILE -o StrictHostKeyChecking=no"

                        echo ">>> Copiando docker-compose.mock.yml a ${TARGET}..."
                        scp $SSH_OPTS \
                            $COMPOSE_FILE \
                            $TARGET:/home/ubuntu/docker-compose.mock.yml

                        echo ">>> Ejecutando deploy en ${TARGET}..."
                        ssh $SSH_OPTS $TARGET "
                            docker compose -f /home/ubuntu/docker-compose.mock.yml up -d --remove-orphans
                            echo '--- Estado de contenedores ---'
                            docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
                        "
                        echo "✅ Mock desplegado en http://${APP_SERVER_IP}"
                    '''
                }
            }
        }

    }

    
    post {
        always {
            script {
                // Generar resumen consolidado para WhatsApp
                sh '''
                    # Generar resumen sin separadores de guiones
                    echo "*📦 RESUMEN DE COMPILACIÓN*" > summary_wa.txt
                    if [ -f builds.log ]; then
                        # Filtrar solo estados relevantes y limpiar códigos ANSI + duraciones
                        grep -E "Verificando:|Backend|Science|Rust|Frontend|Total:|Exitosos:|Fallados:" builds.log | \
                        grep -v "Verificando compilación" | grep -v "Iniciando" | \
                        sed -E 's/\x1b\[[0-9;]*m//g' | sed 's/ (SKIP)//g' >> summary_wa.txt
                    fi
                    
                    echo "" >> summary_wa.txt
                    echo "*🧪 RESUMEN DE TESTS (DATA SCIENCE)*" >> summary_wa.txt
                    if [ -f ds_tests.log ]; then
                        # Filtrar estados de tests, limpiar códigos ANSI, duraciones de pytest e iconos de ejecución
                        grep -E "Health Check|Unit Tests|Integration|FALLARON|EXITOSAMENTE" ds_tests.log | \
                        grep -v "Ejecutando" | \
                        sed -E 's/\x1b\[[0-9;]*m//g' | sed -E 's/ in [0-9.]+s//g' >> summary_wa.txt
                    fi
                '''
            }
        }
        success {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '✅ ¡TODOS LOS COMPONENTES PASARON!'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '🎉 El proyecto está listo para merge'
            
            // Notificación WhatsApp (Issue #10)
            script {
                try {
                        withCredentials([
                            string(credentialsId: 'waha-recipient', variable: 'WAHA_RECIPIENT'),
                            string(credentialsId: 'waha-api-key', variable: 'WAHA_API_KEY')
                        ]) {
                            def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                            sh "./ci-cd/jenkins/scripts/notify_whatsapp.sh SUCCESS \"${BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown'}\" \"${commitHash}\" summary_wa.txt"
                        }
                } catch (Exception e) {
                    echo "⚠️ No se pudo enviar notificación de WhatsApp: ${e.message}"
                }
            }
        }
        failure {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '❌ ALGUNOS COMPONENTES FALLARON'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '⚠️  Revisa los logs arriba para ver qué falló'
            
            // Notificación WhatsApp (Issue #10)
            script {
                try {
                        withCredentials([
                            string(credentialsId: 'waha-recipient', variable: 'WAHA_RECIPIENT'),
                            string(credentialsId: 'waha-api-key', variable: 'WAHA_API_KEY')
                        ]) {
                            def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                            sh "./ci-cd/jenkins/scripts/notify_whatsapp.sh FAILURE \"${BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown'}\" \"${commitHash}\" summary_wa.txt"
                        }
                } catch (Exception e) {
                    echo "⚠️ No se pudo enviar notificación de WhatsApp: ${e.message}"
                }
            }
        }
        cleanup {
            echo '🧹 Limpiando workspace...'
            deleteDir() // Más exhaustivo que cleanWs()
        }
    }
}
