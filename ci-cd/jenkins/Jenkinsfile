// Jenkinsfile Maestro - Ejecuta todos los componentes
// 
// Analogía: Este Jenkinsfile es como el "director de orquesta" que coordina
// a todos los mecánicos (otros Jenkinsfiles) para hacer una inspección completa del vehículo.

pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'EquineLead - Full Stack'
        // IP del App Server activo. Cambiar aquí si se migra de AWS a OCI.
        // En Jenkins: Manage Jenkins > Configure System > Global properties > Environment variables
        APP_SERVER_IP   = credentials('app-server-ip')   // registrar en Jenkins Credentials como 'Secret text'
        APP_SERVER_USER = 'ubuntu'
    }
    
    stages {
        stage('🔍 Checkout') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📥 Descargando código del repositorio...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                checkout scm
            }
        }
        
        stage('🔍 Check Builds') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔍 Verificando que todos los componentes compilen...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/check_builds.sh | tee builds.log'
            }
        }
        
        stage('🧪 Run All Tests') {
            when {
                not { branch 'gh-pages' }
            }
            parallel {
                stage('Backend C#') {
                    steps {
                        echo '🔧 Ejecutando tests de Backend C#...'
                        sh './tests/scripts/run_backend_tests.sh'
                    }
                }
                
                stage('Data Science') {
                    steps {
                        echo '🧠 Ejecutando tests de Data Science...'
                        sh './tests/scripts/run_datascience_tests.sh | tee ds_tests.log'
                    }
                }
                
                stage('Scrapper Rust') {
                    steps {
                        echo '🦀 Ejecutando tests de Scrapper Rust...'
                        sh './tests/scripts/run_scrapper_tests.sh'
                    }
                }
                
                stage('Frontend Web') {
                    steps {
                        echo '🎨 Ejecutando tests de Frontend Web...'
                        sh './tests/scripts/run_frontend_tests.sh'
                    }
                }
            }
        }
        
        stage('🔗 Integration Tests') {
            when {
                not { branch 'gh-pages' }
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔗 Ejecutando tests de integración...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/run_integration_tests.sh || echo "Integration tests no disponibles aún"'
            }
        }
        
        stage('🚀 Deploy to AWS (Plan B)') {
            when {
                branch 'dev'
            }
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🚀 Desplegando Aplicación Real en AWS App Server Plan B...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'aws-app-server-key', keyFileVariable: 'SSH_KEY_FILE', usernameVariable: 'SSH_USER'),
                    string(credentialsId: 'db-name', variable: 'DB_NAME'),
                    string(credentialsId: 'db-user', variable: 'DB_USER'),
                    string(credentialsId: 'db-password', variable: 'DB_PASS'),
                    string(credentialsId: 'JWT_SECRET', variable: 'JWT_SECRET')
                ]) {
                    sh '''
                        TARGET="${APP_SERVER_USER}@${APP_SERVER_IP}"
                        SSH_OPTS="-i $SSH_KEY_FILE -o StrictHostKeyChecking=no"

                        echo ">>> Sincronizando código fuente y configuración a ${TARGET}..."
                        # Sincronizar directorios necesarios y el compose principal
                        scp $SSH_OPTS docker-compose.yml ${TARGET}:/home/ubuntu/
                        scp $SSH_OPTS -r src infrastructure ${TARGET}:/home/ubuntu/

                        echo ">>> Generando archivo .env con secretos en ${TARGET}..."
                        ssh $SSH_OPTS $TARGET "
                            echo 'POSTGRES_DB=${DB_NAME}' > /home/ubuntu/.env
                            echo 'POSTGRES_USER=${DB_USER}' >> /home/ubuntu/.env
                            echo 'POSTGRES_PASSWORD=${DB_PASS}' >> /home/ubuntu/.env
                            echo 'DB_HOST=db' >> /home/ubuntu/.env
                            echo 'DB_PORT=5432' >> /home/ubuntu/.env
                            echo 'DATASCIENCE_BASEURL=http://data-science:8090' >> /home/ubuntu/.env
                            echo 'JWT_SECRET=${JWT_SECRET}' >> /home/ubuntu/.env
                        "

                        echo ">>> Ejecutando build y despliegue en ${TARGET}..."
                        ssh $SSH_OPTS $TARGET "
                            cd /home/ubuntu
                            docker compose up -d --build --remove-orphans
                            echo '--- Estado de contenedores reales ---'
                            docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
                        "
                        echo "✅ Aplicación desplegada en http://${APP_SERVER_IP}:5286"
                    '''
                }
            }
        }

    }

    
    post {
        always {
            script {
                // Generar reportes detallados para WhatsApp
                sh '''
                    # Capturar builds_report.md
                    if [ -f builds.log ]; then
                        echo "## 📦 REPORTE DE COMPILACIÓN" > builds_report.md
                        sed -r 's/\\x1b\\[[0-9;]*m//g' builds.log >> builds_report.md
                    else
                        echo "No builds log available" > builds_report.md
                    fi
                    
                    # Capturar tests_report.md (ejecutando run_all_tests.sh si existe)
                    if [ -f ./tests/scripts/run_all_tests.sh ]; then
                        echo "## 🧪 REPORTE DE TESTS" > tests_report.md
                        ./tests/scripts/run_all_tests.sh | sed -r 's/\\x1b\\[[0-9;]*m//g' >> tests_report.md
                    else
                        echo "No tests report available" > tests_report.md
                    fi
                '''
            }
        }
        success {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '✅ ¡TODOS LOS COMPONENTES PASARON!'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '🎉 El proyecto está listo para merge'
            
            // Notificación WhatsApp (Issue #10)
            script {
                try {
                        withCredentials([
                            string(credentialsId: 'waha-recipient', variable: 'WAHA_RECIPIENT'),
                            string(credentialsId: 'waha-api-key', variable: 'WAHA_API_KEY')
                        ]) {
                            def branchName = env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: 'unknown'
                            def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                            sh "./ci-cd/jenkins/scripts/notify_whatsapp.sh SUCCESS \"${branchName}\" \"${commitHash}\" builds_report.md tests_report.md"
                        }
                } catch (Exception e) {
                    echo "⚠️ No se pudo enviar notificación de WhatsApp: ${e.message}"
                }
            }
        }
        failure {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '❌ ALGUNOS COMPONENTES FALLARON'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '⚠️  Revisa los logs arriba para ver qué falló'
            
            // Notificación WhatsApp (Issue #10)
            script {
                try {
                        withCredentials([
                            string(credentialsId: 'waha-recipient', variable: 'WAHA_RECIPIENT'),
                            string(credentialsId: 'waha-api-key', variable: 'WAHA_API_KEY')
                        ]) {
                            def branchName = env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: 'unknown'
                            def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                            sh "./ci-cd/jenkins/scripts/notify_whatsapp.sh FAILURE \"${branchName}\" \"${commitHash}\" builds_report.md tests_report.md"
                        }
                } catch (Exception e) {
                    echo "⚠️ No se pudo enviar notificación de WhatsApp: ${e.message}"
                }
            }
        }
        cleanup {
            echo '🧹 Limpiando workspace...'
            deleteDir() // Más exhaustivo que cleanWs()
        }
    }
}
