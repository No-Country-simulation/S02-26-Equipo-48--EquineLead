// Jenkinsfile for Scrapper Rust Component
// 
// Analogía: Este Jenkinsfile es como el "manual de inspección de sensores" que sigue
// el mecánico automático (Jenkins) cada vez que hay cambios en el scrapper.

pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'EquineLead Scrapper Rust'
    }
    
    stages {
        stage('🔍 Checkout') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📥 Descargando código del repositorio...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                checkout scm
            }
        }
        
        stage('🔨 Build') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔨 Compilando Scrapper Rust...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                script {
                    if (fileExists('src/scrapper-rust/Cargo.toml')) {
                        dir('src/scrapper-rust') {
                            sh 'cargo build --release'
                        }
                    } else {
                        echo '⚠️  Cargo.toml no encontrado en src/scrapper-rust'
                    }
                }
            }
        }
        
        stage('🔍 Clippy (Lint)') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔍 Verificando estilo de código con Clippy...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                script {
                    if (fileExists('src/scrapper-rust/Cargo.toml')) {
                        dir('src/scrapper-rust') {
                            sh 'cargo clippy -- -D warnings || true'
                        }
                    }
                }
            }
        }
        
        stage('🧪 Test') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🧪 Ejecutando tests...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/run_scrapper_tests.sh'
            }
        }
    }
    
    post {
        success {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '✅ Scrapper Rust - BUILD Y TESTS EXITOSOS'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
        }
        failure {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '❌ Scrapper Rust - BUILD O TESTS FALLARON'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
        }
        always {
            echo '🧹 Limpiando workspace...'
            cleanWs()
        }
    }
}
