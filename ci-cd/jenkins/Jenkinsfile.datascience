// Jenkinsfile for Data Science Component
// 
// Analogía: Este Jenkinsfile es como el "manual de inspección del cerebro" que sigue
// el mecánico automático (Jenkins) cada vez que hay cambios en el código ML/IA.

pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'EquineLead Data Science'
        PYTHONUNBUFFERED = '1'
    }
    
    stages {
        stage('🔍 Checkout') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📥 Descargando código del repositorio...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                checkout scm
            }
        }
        
        stage('📦 Setup') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📦 Instalando dependencias de Python...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                script {
                    if (fileExists('src/data-science/requirements.txt')) {
                        sh 'pip3 install -r src/data-science/requirements.txt'
                    } else {
                        echo '⚠️  requirements.txt no encontrado'
                    }
                    
                    // Instalar pytest para tests
                    sh 'pip3 install pytest pytest-cov'
                }
            }
        }
        
        stage('🔍 Lint') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🔍 Verificando estilo de código (linting)...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                script {
                    // Opcional: agregar flake8 o pylint
                    echo '⚠️  Linting no configurado aún (opcional para MVP)'
                }
            }
        }
        
        stage('🧪 Test') {
            steps {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '🧪 Ejecutando tests...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                sh './tests/scripts/run_datascience_tests.sh'
            }
        }
    }
    
    post {
        success {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '✅ Data Science - SETUP Y TESTS EXITOSOS'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
        }
        failure {
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            echo '❌ Data Science - SETUP O TESTS FALLARON'
            echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
        }
        always {
            echo '🧹 Limpiando workspace...'
            cleanWs()
        }
    }
}
