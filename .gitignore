.jenkins/
pipeline_logs/

# --- Paquetes y Dependencias Globales ---
node_modules/
dist/
build/
out/
# --- MkDocs (Static Site Generator) ---
site/
.cache/

# --- MkDocs Staging (Technical) ---
.docs_staging/
